# Скопировать в .env (права 600, не в git — Promt_MMWS.md, раздел 2).
MMWS_DATABASE_URL=postgresql+asyncpg://mmws:mmws@localhost:5432/mmws
MMWS_JWT_SECRET_KEY=change-me-to-a-random-64-char-string
MMWS_SECRET_ENCRYPTION_KEY=change-me-fernet-key-see-generate-command-below
MMWS_GATEWAY_GRPC_TARGET=localhost:50051

# Сгенерировать MMWS_SECRET_ENCRYPTION_KEY:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Бутстрап первого Супер-администратора (app/bootstrap.py), не используется
# после первого запуска:
MMWS_INITIAL_SUPERADMIN_USERNAME=superadmin
MMWS_INITIAL_SUPERADMIN_PASSWORD=change-me

# Ежедневный экспорт профиля нагрузки (Profile1) во внешнюю БД ЕЭБД —
# см. services/eudb_export.py. Пусто = экспорт неактивен.
MMWS_EUDB_HOST=
MMWS_EUDB_PORT=5432
MMWS_EUDB_DATABASE=
MMWS_EUDB_USER=
MMWS_EUDB_PASSWORD=
